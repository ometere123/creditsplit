{
  "name": "creditsplit-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app lib scripts tests --max-warnings=0",
    "test": "vitest run --config vitest.config.mjs",
    "test:delivery": "node --test tests/verify-delivery.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:connected": "playwright test --config=playwright.connected.config.ts",
    "verify:delivery": "node scripts/verify-delivery.mjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.16",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
